.ps 14
.vs 15
.PS

# Every element of the ROS graph in the dogzilla demo, labelled with the QML type
# that declares it. Left column: dogzillad (Ros2.Node nodeName "dogzillad",
# nodeNamespace "/dogzilla"). Right column: the digital twin (nodeName "digitwin").
# Cross-checked against dogzilla/doc/rosgraph.dot exported from rqt_graph.
# Topic names in the middle are relative to the /dogzilla namespace.

boxwid = 2.5
boxht = 0.3
gap = 4              # clear space between the columns, where the topic name goes
pitch = 0.35            # vertical distance between rows
pad = 0.2              # padding inside the process boxes
lx = 0                  # centre of the dogzillad column
rx = boxwid + gap       # centre of the digitwin column
mx = (lx + rx) / 2      # middle of the gap: topic names and group headings
tl = 0.12              # how far above the arrow the topic name sits

# A matched pair: publisher on the robot, subscriber in the twin.
# $1 dogzillad type, $2 twin type, $3 topic
define row {
	L: box $1 at (lx, y) shaded "darkseagreen2";
	R: box $2 at (rx, y) shaded "darkseagreen2";
	arrow from L.e to R.w;
	$3 at (mx, y + tl);
	y = y - pitch;
}

# Same, but the traffic flows right to left: the twin commands the robot.
define lrow {
	L: box $1 at (lx, y) shaded "lightcyan";
	R: box $2 at (rx, y) shaded "lightcyan";
	arrow from R.w to L.e;
	$3 at (mx, y + tl);
	y = y - pitch;
}

# Request/response pairs (actions, services): traffic both ways.
define birow {
	L: box $1 at (lx, y) shaded "lavenderblush2";
	R: box $2 at (rx, y) shaded "lavenderblush2";
	arrow <-> from L.e to R.w;
	$3 at (mx, y + tl);
	y = y - pitch;
}

# Published by the robot, but nothing in the twin subscribes.
define stub {
	L: box $1 at (lx, y) shaded "mintcream";
	arrow from L.e right gap * 0.3;
	$2 at (L.e + (gap * 0.18, tl));
	$3 ljust at L.e + (gap * 0.36, 0);
	y = y - pitch;
}

# Group heading, centred in the gap.
define head {
	$1 at (mx, y);
	y = y - pitch;
}

y = 0
head("\fIstate and sensors: robot \[->] twin\fP")

row("JointStatePublisher", "JointStateSubscriber", "/joint_states")
row("PoseStampedPublisher", "PoseStampedSubscriber", "/body_pose/state")
row("BatteryStatePublisher", "BatteryStateSubscriber", "/battery_state")
row("TemperaturePublisher", "TemperatureSubscriber", "/telemetry/temperature")
row("StampedTelemetryPublisher", "StampedTelemetrySubscriber", "/telemetry/system")
row("CompressedImagePublisher", "CompressedImageSubscriber", "/camera/image/compressed")
row("LaserScanPublisher", "LaserScanSubscriber", "/sensor_msgs/msg/LaserScan")
row("ChatMessagePublisher", "ChatMessageSubscriber", "/speech/log")
row("StringPublisher", "StringSubscriber", "/speech/state")
stub("TwistPublisher", "/vel", "\fIno subscriber in the twin\fP")
stub("StaticTransformBroadcaster", "/tf_static", "\fIlatched for tf2 listeners\fP")

y = y - pitch * 0.2
head("\fIcommands: twin \[->] robot\fP")

lrow("TwistSubscriber", "TwistPublisher", "/cmd_vel")
lrow("PoseStampedSubscriber", "PoseStampedPublisher", "/body_pose/command")
lrow("BoolSubscriber", "BoolPublisher", "/speech/listen")
lrow("StringSubscriber", "StringPublisher", "/motion/library")

y = y - pitch * 0.2
head("\fIactions and services: both directions\fP")

birow("SpeakActionServer", "SpeakActionClient", "/speech/speak")
birow("PlayMotionActionServer", "PlayMotionActionClient", "/motion/play")
birow("TriggerServiceServer", "TriggerServiceClient", "/speech/stop")

# Written out rather than birow(), for the two-line label.
y = y - pitch * 0.35
LP: box "Ros2.Parameter \[mu]3" at (lx, y) shaded "beige";
RP: box "Ros2.RemoteParameter \[mu]3" at (rx, y) shaded "beige";
arrow <-> from LP.e to RP.w;
"audio.master,  audio.mic," at (mx, y + tl + 0.18)
"motors.engaged" at (mx, y + tl)
y = y - pitch

# The process boxes, sized to enclose their column. pic has no two-corner box, so
# the extent is computed: top leaves room for the two header lines.
top = boxht / 2 + 0.1
boty = y + pitch - boxht / 2 - pad
bw = boxwid + 2 * pad
bh = top - boty - pad

RobotBox: box wid bw ht bh at (lx, (top + boty) / 2);
"\fBdogzillad\fP" at (lx, boxht / 2 - 0.2)

DigitwinBox: box wid bw ht bh at (rx, (top + boty) / 2);
"\fBDigital Twin\fP" at (rx, boxht / 2 - 0.2)

.PE
